{
  "name": "linguarium",
  "version": "0.1.0",
  "description": "Linguarium - a free, language-agnostic learning platform: structured study, natural reading, active practice and FSRS spaced repetition in one place.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npx --yes --package netlify-cli netlify dev",
    "dev:ui": "npm run build && node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "db:init": "node scripts/db-init.mjs",
    "db:seed": "node scripts/db-init.mjs --seed-only",
    "db:auto": "node scripts/db-auto.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@netlify/identity": "^2.0.1",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "esbuild": "^0.28.2"
  }
}
