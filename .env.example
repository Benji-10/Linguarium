# Copy this file to `.env` for local development with `netlify dev`.
# On Netlify, set the same variables in Site settings > Environment variables.
# NEVER commit the real .env file.

# Required: Neon PostgreSQL connection string.
# Use the *pooled* connection string from the Neon dashboard (includes "-pooler").
DATABASE_URL=postgres://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional: Google AI Studio key for vocabulary enrichment (Gemini).
# If omitted, the app works fully - AI features are disabled and clearly marked.
GEMINI_API_KEY=

# Optional: daily AI-enrichment requests per user (default 300).
GEMINI_DAILY_LIMIT=300

# Optional: guards POST /api/admin-seed, the one-click way to populate the
# database from the deployed site (schema + seed data). Use a long random
# string (32+ characters). If unset, that endpoint simply answers 404.
# Example: ADMIN_KEY="$(openssl rand -hex 32)"
ADMIN_KEY=
